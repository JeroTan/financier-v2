---
import AppLayout from "@/layouts/AppLayout.astro";
import { ErrorBoundary } from "@/components/ErrorBoundary";
import { StatsDashboard } from "@/components/stats/StatsDashboard";
---

<AppLayout title="Stats" currentPage="/stats">
  <ErrorBoundary>
    <div class="mx-auto max-w-5xl space-y-6">
      <header class="border-b border-outline-variant pb-5">
        <p class="label-md text-primary">Financial overview</p>
        <h1 class="headline-lg mt-2">Statistics</h1>
      </header>
      <StatsDashboard client:load />
    </div>
  </ErrorBoundary>
</AppLayout>
