---
import AppLayout from "@/layouts/AppLayout.astro";
import { ErrorBoundary } from "@/components/ErrorBoundary";
import { EntryPanel } from "@/features/entry/EntryPanel";

const token = Astro.cookies.get("refresh_token")?.value ?? "";
---

<AppLayout title="New Entry" currentPage="/entry">
  <ErrorBoundary>
    <div class="space-y-6">
      <h1 class="headline-lg">New Entry</h1>
      <p class="body-lg text-muted-foreground">
        Add a new financial transaction manually.
      </p>
      <EntryPanel client:load token={token} />
    </div>
  </ErrorBoundary>
</AppLayout>
