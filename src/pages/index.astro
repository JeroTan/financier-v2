---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
---

<Layout title="Financier">
  <div class="app-layout">
    <!-- Nav Pane -->
    <aside class="nav-pane" style="background: var(--surface-container-lowest); border-right: 1px solid var(--chat-border); padding: 24px 16px;">
      <h1 class="headline-md" style="color: var(--primary); margin-bottom: 24px;">Financier</h1>
      <nav style="display: flex; flex-direction: column; gap: 8px;">
        <a href="#" style="padding: 8px 12px; border-radius: var(--radius); background: var(--primary-fixed); color: var(--on-primary-fixed); font-weight: 600;">Chat</a>
        <a href="#" style="padding: 8px 12px; border-radius: var(--radius); color: var(--on-surface-variant);">Transactions</a>
        <a href="#" style="padding: 8px 12px; border-radius: var(--radius); color: var(--on-surface-variant);">Stats</a>
        <a href="#" style="padding: 8px 12px; border-radius: var(--radius); color: var(--on-surface-variant);">Settings</a>
      </nav>
    </aside>

    <!-- Chat Pane -->
    <main class="chat-content" style="background: var(--surface); display: flex; flex-direction: column;">
      <!-- Header -->
      <header style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--chat-border); margin-bottom: 16px;">
        <h2 class="headline-md">Financial Assistant</h2>
        <ThemeToggle />
      </header>

      <!-- Messages -->
      <div style="flex: 1; display: flex; flex-direction: column; gap: 16px; overflow-y: auto;">
        <!-- Bot Message -->
        <div class="message-cluster">
          <div class="chat-bubble-bot">
            Welcome to Financier! I'm your AI financial assistant. How can I help you today?
          </div>
          <span class="body-sm" style="color: var(--outline); font-size: 11px;">Just now</span>
        </div>

        <!-- User Message -->
        <div class="message-cluster">
          <div class="chat-bubble-user">
            Show me my spending this month
          </div>
          <span class="body-sm" style="color: var(--outline); font-size: 11px; text-align: right;">Just now</span>
        </div>

        <!-- Bot Message with Card -->
        <div class="message-cluster">
          <div class="chat-bubble-bot">
            Here's your spending overview for this month:
          </div>
          <div class="financial-card expense" style="max-width: 320px;">
            <div class="financial-card-header">
              <span style="font-size: 20px;">🛒</span>
              <span class="body-lg" style="font-weight: 600;">Shopping</span>
            </div>
            <div class="financial-card-amount" style="color: var(--expense);">-$1,234.56</div>
            <div class="financial-card-footer">
              <span>Today, 2:30 PM</span>
              <span>Visa •••• 4242</span>
            </div>
          </div>
          <div class="financial-card income" style="max-width: 320px;">
            <div class="financial-card-header">
              <span style="font-size: 20px;">💰</span>
              <span class="body-lg" style="font-weight: 600;">Salary</span>
            </div>
            <div class="financial-card-amount" style="color: var(--income);">+$5,000.00</div>
            <div class="financial-card-footer">
              <span>May 1, 9:00 AM</span>
              <span>Direct Deposit</span>
            </div>
          </div>
        </div>

        <!-- Chips -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="chip">Monthly Report</button>
          <button class="chip">Last Expense</button>
          <button class="chip">Budget Status</button>
        </div>

        <!-- Progress Bar -->
        <div style="max-width: 320px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span class="label-md">Monthly Budget</span>
            <span class="body-sm" style="color: var(--on-surface-variant);">$1,234 / $3,000</span>
          </div>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: 41%;"></div>
          </div>
        </div>
      </div>

      <!-- Input -->
      <div class="chat-input">
        <button class="chat-input-attach" type="button" aria-label="Attach file">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
          </svg>
        </button>
        <input class="chat-input-field" type="text" placeholder="Type a message..." />
        <button class="chat-input-send" type="button" aria-label="Send message">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
        </button>
      </div>
    </main>

    <!-- Widget Pane -->
    <aside class="widget-pane" style="background: var(--surface-container-lowest); border-left: 1px solid var(--chat-border); padding: 24px 16px;">
      <h3 class="headline-md" style="margin-bottom: 16px;">Total Wealth</h3>
      <div class="data-display" style="color: var(--primary); margin-bottom: 24px;">$24,567.89</div>

      <h4 class="body-lg" style="font-weight: 600; margin-bottom: 12px;">Expense Breakdown</h4>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <span class="body-sm">Shopping</span>
            <span class="body-sm" style="color: var(--on-surface-variant);">41%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: 41%;"></div>
          </div>
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <span class="body-sm">Food</span>
            <span class="body-sm" style="color: var(--on-surface-variant);">28%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: 28%;"></div>
          </div>
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <span class="body-sm">Transport</span>
            <span class="body-sm" style="color: var(--on-surface-variant);">18%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: 18%;"></div>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <!-- Mobile Bottom Nav -->
  <nav class="bottom-nav">
    <button class="bottom-nav-item active">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
      <span class="label-md">Chat</span>
    </button>
    <button class="bottom-nav-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="1" x2="12" y2="23" />
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
      </svg>
      <span class="label-md">Stats</span>
    </button>
    <button class="bottom-nav-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
      </svg>
      <span class="label-md">Settings</span>
    </button>
  </nav>
</Layout>
