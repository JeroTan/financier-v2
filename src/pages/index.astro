---
// Landing page — public route, no auth required
const APP_URL = Astro.env.APP_URL ?? "https://financier.app";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Financier — AI-Powered Personal Finance Tracker</title>
    <meta name="description" content="Track your income and expenses with AI-powered chat. Natural conversation meets smart finance management. Free, fast, and beautiful." />
    <link rel="canonical" href={APP_URL} />

    <!-- Open Graph -->
    <meta property="og:title" content="Financier — AI-Powered Personal Finance Tracker" />
    <meta property="og:description" content="Track your income and expenses with AI-powered chat. Natural conversation meets smart finance management." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={APP_URL} />
    <meta property="og:image" content={`${APP_URL}/og-image.png`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Financier — AI-Powered Personal Finance Tracker" />
    <meta name="twitter:description" content="Track your income and expenses with AI-powered chat." />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&display=swap" />

    <style is:global>
      @import "../styles/global.css";
    </style>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Financier",
      "description": "AI-powered personal finance tracker with natural language chat interface",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    })} />

    <script>
      (function () {
        const theme = localStorage.getItem("theme");
        if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>

    <style>
      .landing-body { font-family: "Hanken Grotesk", system-ui, sans-serif; }
      .nav { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; max-width: 1200px; margin: 0 auto; }
      .nav-logo { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; }
      .nav-links { display: flex; align-items: center; gap: 16px; }
      .nav-link { color: var(--on-surface-variant); text-decoration: none; font-size: 0.9rem; }
      .nav-link:hover { color: var(--primary); }
      .nav-btn { display: inline-flex; align-items: center; height: 36px; padding: 0 20px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; transition: all 0.2s; }
      .nav-btn-primary { background: var(--primary); color: var(--on-primary); }
      .nav-btn-primary:hover { opacity: 0.9; }
      .nav-btn-ghost { color: var(--on-surface); background: transparent; }
      .nav-btn-ghost:hover { background: var(--surface-container); }

      .hero { text-align: center; padding: 80px 24px 60px; max-width: 800px; margin: 0 auto; }
      .hero-badge { display: inline-block; padding: 6px 16px; border-radius: 999px; background: var(--primary-container); color: var(--on-primary-container); font-size: 0.85rem; font-weight: 600; margin-bottom: 24px; }
      .hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; color: var(--on-background); margin: 0 0 16px; }
      .hero h1 span { color: var(--primary); }
      .hero p { font-size: clamp(1rem, 2vw, 1.25rem); color: var(--on-surface-variant); line-height: 1.6; max-width: 600px; margin: 0 auto 32px; }
      .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
      .hero-btn { display: inline-flex; align-items: center; height: 48px; padding: 0 32px; border-radius: 12px; font-size: 1rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
      .hero-btn-primary { background: var(--primary); color: var(--on-primary); }
      .hero-btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
      .hero-btn-secondary { background: var(--surface-container); color: var(--on-surface); }
      .hero-btn-secondary:hover { background: var(--surface-container-high); }

      .features { padding: 60px 24px 80px; max-width: 1200px; margin: 0 auto; }
      .features h2 { text-align: center; font-size: 2rem; font-weight: 700; margin: 0 0 48px; color: var(--on-background); }
      .features-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
      @media (min-width: 768px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
      .feature-card { padding: 32px; border-radius: 16px; background: var(--surface-container-low); border: 1px solid var(--outline-variant); transition: all 0.2s; }
      .feature-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
      .feature-icon { font-size: 2.5rem; margin-bottom: 16px; }
      .feature-card h3 { font-size: 1.25rem; font-weight: 600; margin: 0 0 8px; color: var(--on-background); }
      .feature-card p { color: var(--on-surface-variant); line-height: 1.6; margin: 0; }

      .cta { text-align: center; padding: 60px 24px 80px; max-width: 600px; margin: 0 auto; }
      .cta h2 { font-size: 2rem; font-weight: 700; margin: 0 0 16px; color: var(--on-background); }
      .cta p { color: var(--on-surface-variant); margin: 0 0 32px; }

      .footer { text-align: center; padding: 24px; border-top: 1px solid var(--outline-variant); color: var(--on-surface-variant); font-size: 0.85rem; }

      .theme-toggle { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--outline-variant); border-radius: 9999px; background: transparent; color: var(--on-surface); cursor: pointer; transition: all 0.2s; }
      .theme-toggle:hover { background: var(--surface-container); }
      .icon-sun { display: none; }
      .icon-moon { display: block; }
      [data-theme="dark"] .icon-sun { display: block; }
      [data-theme="dark"] .icon-moon { display: none; }
    </style>
  </head>
  <body class="landing-body" style="margin: 0; background: var(--background); color: var(--on-background);">
    <!-- Navigation -->
    <nav class="nav">
      <a href="/" class="nav-logo">Financier</a>
      <div class="nav-links">
        <a href="#features" class="nav-link">Features</a>
        <a href="/login" class="nav-btn nav-btn-ghost">Sign In</a>
        <a href="/register" class="nav-btn nav-btn-primary">Get Started</a>
        <button class="theme-toggle" type="button" aria-label="Toggle theme" onclick="toggleTheme()">
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">✨ AI-Powered Finance</div>
      <h1>Track Your Money<br />With <span>AI Chat</span></h1>
      <p>Just tell Financier what you spent. No forms, no categories to pick. Natural conversation meets smart finance management.</p>
      <div class="hero-actions">
        <a href="/register" class="hero-btn hero-btn-primary">Get Started Free</a>
        <a href="/login" class="hero-btn hero-btn-secondary">Sign In</a>
      </div>
    </section>

    <!-- Features -->
    <section class="features" id="features">
      <h2>Everything You Need</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">💬</div>
          <h3>AI Chat Entry</h3>
          <p>Just chat with your finances. "I spent $50 on groceries" — done. AI parses, confirms, and saves your transactions.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📝</div>
          <h3>Manual Entry</h3>
          <p>Prefer forms? Use our clean, validated entry form with category selection, date picker, and receipt upload.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <h3>Stats Dashboard</h3>
          <p>See your income, expenses, and net at a glance. Daily, monthly, and yearly views with a beautiful ledger format.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎯</div>
          <h3>Goal Tracking</h3>
          <p>Set financial goals and watch your progress. Savings targets, spending limits — all tracked automatically.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <h2>Ready to Take Control?</h2>
      <p>Start tracking your finances in under a minute. No credit card required.</p>
      <a href="/register" class="hero-btn hero-btn-primary">Create Free Account</a>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p>© 2026 Financier. Built with ❤️ for better financial habits.</p>
    </footer>

    <script>
      function toggleTheme() {
        const html = document.documentElement;
        const current = html.getAttribute("data-theme");
        const next = current === "dark" ? "light" : "dark";
        html.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      }
      window.toggleTheme = toggleTheme;
    </script>
  </body>
</html>
