---
import ThemeToggle from "@/components/ThemeToggle.astro";

type AuthMode = "login" | "register";

interface Props {
  mode: AuthMode;
}

const { mode } = Astro.props;

const config =
  mode === "login"
    ? {
        eyebrow: "Sign in to your account",
        action: "/api/auth/login",
        submitLabel: "Sign in",
        alternatePrompt: "Don't have an account?",
        alternateHref: "/register",
        alternateLabel: "Register",
        passwordMinLength: undefined,
        passwordAutocomplete: "current-password",
        passwordHint: undefined,
      }
    : {
        eyebrow: "Create your account",
        action: "/api/auth/register",
        submitLabel: "Sign up",
        alternatePrompt: "Already have an account?",
        alternateHref: "/login",
        alternateLabel: "Sign in",
        passwordMinLength: 8,
        passwordAutocomplete: "new-password",
        passwordHint: "Use at least 8 characters.",
      };
---

<div
  class="flex min-h-screen items-center justify-center bg-background px-4 py-8"
  data-auth-fallback
>
  <div class="w-full max-w-md space-y-6">
    <div class="space-y-2 text-center">
      <h1 class="headline-lg text-primary">Financier</h1>
      <p class="body-lg text-muted-foreground">{config.eyebrow}</p>
    </div>

    <form class="space-y-4" action={config.action} method="POST">
      <div class="space-y-2">
        <label class="label-md" for={`${mode}-fallback-email`}>Email</label>
        <input
          id={`${mode}-fallback-email`}
          name="email"
          type="email"
          autocomplete="email"
          required
          class="h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none transition-colors placeholder:text-muted-foreground focus-visible:ring-1 focus-visible:ring-ring"
          placeholder="you@example.com"
        />
      </div>

      <div class="space-y-2">
        <label class="label-md" for={`${mode}-fallback-password`}
          >Password</label
        >
        <input
          id={`${mode}-fallback-password`}
          name="password"
          type="password"
          autocomplete={config.passwordAutocomplete}
          required
          minlength={config.passwordMinLength}
          class="h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none transition-colors placeholder:text-muted-foreground focus-visible:ring-1 focus-visible:ring-ring"
          placeholder="Password"
          aria-describedby={config.passwordHint
            ? `${mode}-fallback-password-hint`
            : undefined}
        />
        {
          config.passwordHint && (
            <p
              id={`${mode}-fallback-password-hint`}
              class="text-xs text-muted-foreground"
            >
              {config.passwordHint}
            </p>
          )
        }
      </div>

      <button type="submit" class="auth-submit">
        {config.submitLabel}
      </button>
    </form>

    <div class="auth-divider">
      <div class="auth-divider-line">
        <span></span>
      </div>
      <div class="auth-divider-label">
        <span>Or continue with</span>
      </div>
    </div>

    <a href="/api/auth/google" class="auth-oauth">
      <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
        ></path>
        <path
          fill="currentColor"
          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
        ></path>
        <path
          fill="currentColor"
          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
        ></path>
        <path
          fill="currentColor"
          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
        ></path>
      </svg>
      Continue with Google
    </a>

    <p class="text-center text-sm text-muted-foreground mt-2 mb-5">
      {config.alternatePrompt}
      <a href={config.alternateHref} class="text-primary hover:underline"
        >{config.alternateLabel}</a
      >
    </p>

    <div class="flex justify-center pt-5">
      <ThemeToggle />
    </div>
  </div>
</div>
