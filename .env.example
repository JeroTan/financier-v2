# ──────────────────────────────────────────────────────────────
# Financier - Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to git.
#
# The app uses cross-env to set CLOUDFLARE_ENV=development|production
# which selects the matching environment block in wrangler.jsonc.
# ──────────────────────────────────────────────────────────────

# ── Google OAuth ──────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# Public origin used for canonical URLs and Google OAuth callback URLs.
APP_URL=http://localhost:4321

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Password Hashing ──────────────────────────────────────────
# Random string mixed into password hashes. Generate once, never change.
# openssl rand -base64 48
PASSWORD_PEPPER=replace-with-a-long-random-base64-string

# ── JWT Authentication ────────────────────────────────────────
# For development: HS256 symmetric key (used by src/lib/crypto/jwt.ts)
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-string

# For production: RS256 asymmetric keys stored in Cloudflare Secrets Store
# Generate with:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in jwt_private.pem -out jwt_public.pem
# Store via: wrangler secret put JWT_PRIVATE_KEY --env production
#            wrangler secret put JWT_PUBLIC_KEY  --env production

# ── Cloudflare CLI ────────────────────────────────────────────
# Required for Wrangler CLI (wrangler deploy, wrangler secret put)
# Generate at: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
